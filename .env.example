# Credentials from your app at https://developer.whoop.com (Developer Dashboard)
WHOOP_CLIENT_ID=your_client_id
WHOOP_CLIENT_SECRET=your_client_secret

# Must be registered EXACTLY as-is in the WHOOP dashboard
WHOOP_REDIRECT_URI=http://localhost:8007/callback

# Optional: where tokens are stored (defaults to ~/.whoop-mcp/tokens.json)
# WHOOP_TOKEN_FILE=/custom/path/tokens.json
